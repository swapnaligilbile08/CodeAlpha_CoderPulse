DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# Optional: keep data on a persistent disk
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media
# Optional: set to 0 if your host does not use HTTPS
# DJANGO_SSL_REDIRECT=1
